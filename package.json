{
  "name": "open-doing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @open-doing/web dev",
    "build": "pnpm --filter @open-doing/web build",
    "start": "pnpm --filter @open-doing/web start",
    "db:generate": "pnpm --filter @open-doing/web db:generate",
    "db:migrate": "pnpm --filter @open-doing/web db:migrate",
    "db:seed": "pnpm --filter @open-doing/web db:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
