{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@open-doing/server-core": ["../../packages/server-core/src/index.ts"],
      "@open-doing/server-core/*": ["../../packages/server-core/src/*"]
    }
  },
  "include": ["src"]
}
