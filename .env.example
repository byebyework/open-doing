# 本地开发环境变量示例（复制为 .env.local 后按需修改，.env.local 不入库）
# 先运行 `docker compose up -d` 启动 PostgreSQL。

# 开发数据库（docker compose 中的 open_doing）
DATABASE_URL=postgres://open-doing:open-doing@localhost:5432/open_doing

# 测试数据库（pnpm test 的 DB 用例；由 docker/initdb 脚本创建）
TEST_DATABASE_URL=postgres://open-doing:open-doing@localhost:5432/open_doing_test

# 会话签名密钥（生产环境必须替换为强随机值，例如 `openssl rand -base64 32`）
SESSION_SECRET=dev-only-change-me

# cron 路由鉴权密钥（生产环境必须替换为强随机值）
CRON_SECRET=dev-only-change-me
