# 本地开发环境变量示例（复制为 .env.local 后按需修改，.env.local 不入库）
# 先运行 `docker compose up -d --wait` 启动 PostgreSQL（仅数据库，web 由 pnpm dev 在宿主机运行）。

# 开发数据库（应用运行时 + 迁移使用；docker compose 中的 open_doing）
DATABASE_URL=postgres://open-doing:open-doing@localhost:5433/open_doing

# 测试数据库（仅 pnpm test 的 DB 用例使用；由 docker/initdb 脚本创建）
# 应用运行时永不使用该连接串。
TEST_DATABASE_URL=postgres://open-doing:open-doing@localhost:5433/open_doing_test

# better-auth 会话签名密钥（生产环境必须替换为强随机值，例如 `openssl rand -base64 32`）
BETTER_AUTH_SECRET=dev-only-change-me
# better-auth 基地址（可选；未设置时由请求推断）
# 默认注释，避免复制模板后把 e2e 的 3100 端口钉到 3000；
# 需要固定时按环境取消注释，e2e 请改为 http://localhost:3100。
# BETTER_AUTH_URL=http://localhost:3000

# cron 路由鉴权密钥（生产环境必须替换为强随机值）
CRON_SECRET=dev-only-change-me
# 本地触发到期扫描：curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/due-scan

# ---- 端口覆盖（可选）----
# PG_PORT 只被 Docker Compose 读取（默认 5433）；需要换端口时放在仓库根 `.env`
# 或 shell 环境中，不要写进 apps/web/.env.local（该文件只被 Next.js 读取）。
# PG_PORT=5433

# ---- Docker 生产部署（docker-compose.prod.yml）----
# compose 自动读取仓库根目录的 `.env`（不要提交真实值）：
#   POSTGRES_PASSWORD    数据库口令（默认 open-doing，生产务必修改）
#   BETTER_AUTH_SECRET   会话签名密钥（必填，openssl rand -base64 32）
#   CRON_SECRET          cron 路由鉴权密钥（必填）
#   APP_PORT             web 对外端口（默认 3000）
# web 容器启动时先对 DATABASE_URL 执行幂等迁移，再启动应用；
# 设 SKIP_DB_MIGRATION=1 可跳过（改由外部 Job 统一迁移）。
# POSTGRES_PASSWORD=open-doing
# BETTER_AUTH_SECRET=change-me
# CRON_SECRET=change-me
# APP_PORT=3000
# SKIP_DB_MIGRATION=0

# ---- 香港服务器部署（docker-compose.hk.yml）----
# compose 自动读取仓库根目录的 .env（不要提交真实值）：
#   DATABASE_URL         Supabase session pooler 连接串，必须带 ?sslmode=require
#   BETTER_AUTH_SECRET   会话签名密钥（openssl rand -base64 32）
#   CRON_SECRET          cron 路由鉴权密钥
#   BETTER_AUTH_URL      https 默认端口，写 https://<域名>（不带端口号）
#   CERT_DIR             宿主机证书目录（Cloudflare Origin CA 证书位置，只读挂载进 nginx）
# 镜像名固定为 ghcr.io/byebyework/open-doing(:latest/<sha>) 与
# ghcr.io/byebyework/open-doing-nginx:1.27-alpine（由 build-push-ghcr workflow 构建，
# GHCR 包默认私有，服务器需 PAT（read:packages）登录后 pull）。
# web 只发布 127.0.0.1:3000（cron 从回环触发）；公网入口为 nginx 443。
