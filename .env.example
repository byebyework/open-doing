# 本地开发环境变量示例（复制为 .env.local 后按需修改，.env.local 不入库）
# 先运行 `docker compose up -d --wait` 启动 PostgreSQL（仅数据库，web 由 pnpm dev 在宿主机运行）。

# 开发数据库（应用运行时 + 迁移使用；docker compose 中的 open_doing）
DATABASE_URL=postgres://open-doing:open-doing@localhost:5433/open_doing

# 测试数据库（仅 pnpm test 的 DB 用例使用；由 docker/initdb 脚本创建）
# 应用运行时永不使用该连接串。
TEST_DATABASE_URL=postgres://open-doing:open-doing@localhost:5433/open_doing_test

# better-auth 会话签名密钥（生产环境必须替换为强随机值，例如 `openssl rand -base64 32`）
BETTER_AUTH_SECRET=dev-only-change-me
# better-auth 基地址（可选；未设置时由请求推断）
# 默认注释，避免复制模板后把 e2e 的 3100 端口钉到 3000；
# 需要固定时按环境取消注释，e2e 请改为 http://localhost:3100。
# BETTER_AUTH_URL=http://localhost:3000

# cron 路由鉴权密钥（生产环境必须替换为强随机值）
CRON_SECRET=dev-only-change-me
# 本地触发到期扫描：curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/due-scan

# ---- 端口覆盖（可选）----
# PG_PORT 只被 Docker Compose 读取（默认 5433）；需要换端口时放在仓库根 `.env`
# 或 shell 环境中，不要写进 apps/web/.env.local（该文件只被 Next.js 读取）。
# PG_PORT=5433
