# 本地开发环境变量示例（复制为 .env.local 后按需修改，.env.local 不入库）
# 宿主机开发（README 方式 B）先运行 `docker compose up -d postgres` 启动 PostgreSQL。

# 开发数据库（应用运行时 + 迁移使用；docker compose 中的 open_doing）
DATABASE_URL=postgres://open-doing:open-doing@localhost:5432/open_doing

# 测试数据库（仅 pnpm test 的 DB 用例使用；由 docker/initdb 脚本创建）
# 应用运行时永不使用该连接串。
TEST_DATABASE_URL=postgres://open-doing:open-doing@localhost:5432/open_doing_test

# 会话签名密钥（生产环境必须替换为强随机值，例如 `openssl rand -base64 32`）
SESSION_SECRET=dev-only-change-me

# cron 路由鉴权密钥（生产环境必须替换为强随机值）
CRON_SECRET=dev-only-change-me
# 本地触发到期扫描：curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/due-scan

# ---- docker compose 一键启动（README 方式 A）----
# 以下变量仅在把本文件复制为仓库根 `.env` 时被 Compose 读取；
# 作为 apps/web/.env.local 使用时会被忽略。
# WEB_PORT=3000
# POSTGRES_PORT=5432
